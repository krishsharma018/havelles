# =============================================================================
# SLM Project — .gitignore
# =============================================================================

# ─── Confidential / Proprietary Data ─────────────────────────────────────────
# Havells washing machine synthetic dataset (large + proprietary)
data_v5_leakage_controlled/*.jsonl

# Proprietary metadata (9MB CSV with washing machine run data)
metadata/washing_machine_synthetic_v5_metadata.csv

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/

# ─── ESP-IDF Build Artifacts ──────────────────────────────────────────────────
# Compiled output — regenerated by idf.py build
esp32_tflite_test/build/
esp32_llm_test/esp32_llm_runtime/build/

# Generated binary model files (large, reproducible)
# esp32_llm_test/main/model_data.h  # uncomment if you regenerate this

# Old SDK configs
sdkconfig.old
esp32_tflite_test/sdkconfig.old
esp32_llm_test/esp32_llm_runtime/sdkconfig.old


# ─── Local Toolchain ──────────────────────────────────────────────────────────
# ESP-IDF local installation (machine-specific, can be GBs)
.espressif/

# ─── OS / System ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv/
venv/
*.egg-info/

# ─── Secrets / Credentials ────────────────────────────────────────────────────
*.key
*.pem
*.secret
.env.local
secrets.toml
